<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FDFBFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="448dp"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Ícone de Cabeçalho -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_header_icon"
                android:elevation="6dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bus"
                    android:contentDescription="@null" />
            </FrameLayout>

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/bus_schedules_title"
                android:textColor="#1C1B1F"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:textAlignment="center" />

            <!-- Subtítulo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="32dp"
                android:paddingHorizontal="16dp"
                android:text="@string/bus_schedules_subtitle"
                android:textColor="#49454F"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.2"
                android:textAlignment="center" />

            <!-- Botão 1: Horários Jotur -->
            <LinearLayout
                android:id="@+id/btn_jotur"
                android:tag="button_jotur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="84dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_btn_jotur"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_jotur"
                        android:textColor="#9921005D"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/btn_jotur"
                        android:textColor="#21005D"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_badge_jotur">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_out"
                        android:contentDescription="@string/btn_jotur_desc" />
                </FrameLayout>
            </LinearLayout>

            <!-- Botão 2: Horários Fênix -->
            <LinearLayout
                android:id="@+id/btn_fenix"
                android:tag="button_fenix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="84dp"
                android:layout_marginBottom="36dp"
                android:background="@drawable/bg_btn_fenix"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_fenix"
                        android:textColor="#991D192B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/btn_fenix"
                        android:textColor="#1D192B"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_badge_fenix">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_out"
                        android:contentDescription="@string/btn_fenix_desc" />
                </FrameLayout>
            </LinearLayout>

            <!-- Rodapé com divisor e label regional -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E7E0EC" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:text="@string/region_label"
                    android:textColor="#938F99"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E7E0EC" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
